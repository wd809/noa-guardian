# NOA Guardian Dock — variables de entorno (SOLO nombres; los valores viven
# en el entorno o en la bóveda, nunca en el repositorio).
DOCK_PORT=
DOCK_TOKEN=
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
META_MODEL_API_KEY=
AI_PROVIDER_DEFAULT=
BUDGET_USD_LIMIT=
NODE_ENV=
# PennDOT RCRS (incidentes viales de PA): credenciales PDAuth que emite
# PennDOT tras el Data Feed Request Form. Sin ellas, la fuente queda en
# estado declarado «not_configured» (no es un fallo).
PENNDOT_USER=
PENNDOT_PASS=
