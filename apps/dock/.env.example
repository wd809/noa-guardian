# NOA Guardian Dock — variables de entorno (SOLO nombres; los valores viven
# en el entorno o en la bóveda, nunca en el repositorio).
DOCK_PORT=
DOCK_TOKEN=
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
META_MODEL_API_KEY=
AI_PROVIDER_DEFAULT=
BUDGET_USD_LIMIT=
NODE_ENV=
# CORS en producción (obligatorio con NODE_ENV=production): orígenes de la
# PWA separados por comas. Ejemplo: DOCK_CORS_ORIGINS=https://dock.casa,http://192.168.1.50:8000
DOCK_CORS_ORIGINS=
# DOCK_TRUST_PROXY=1 solo detrás de un proxy inverso propio (para que el
# rate-limit vea la IP real en X-Forwarded-For). DOCK_HSTS=1 solo tras HTTPS.
DOCK_TRUST_PROXY=
DOCK_HSTS=
# Visión (Etapa D, D6): modelo y base opcionales; la llave manda.
META_MODEL_ID=
META_API_BASE_URL=
# Corpus legal: directorio con las piezas §3 (por defecto, ./corpus del repo).
CORPUS_DIR=
# PennDOT RCRS (incidentes viales de PA): credenciales PDAuth que emite
# PennDOT tras el Data Feed Request Form. Sin ellas, la fuente queda en
# estado declarado «not_configured» (no es un fallo).
PENNDOT_USER=
PENNDOT_PASS=
# AirNow (US EPA, calidad del aire): apiKey GRATUITA que se pide en
# docs.airnowapi.org (Log In → nueva cuenta). Sin ella, la fuente queda
# declarada «not_configured» (no es un fallo). Costo: $0.
AIRNOW_API_KEY=
